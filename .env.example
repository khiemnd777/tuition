# Docker local environment for the ABC SUN QR stack.
# Copy to .env and replace placeholder values as needed.

ABC_ENV=local

API_PORT=18180
ADMIN_PORT=18181
POSTGRES_PORT=15436
REDIS_PORT=16381
VITE_USE_POLLING=true

POSTGRES_DB=abcsun
POSTGRES_USER=abcsun
POSTGRES_PASSWORD=abcsun_local_password

ABC_DATABASE_URL_LOCAL=postgres://abcsun:abcsun_local_password@postgres:5432/abcsun?sslmode=disable
REDIS_URL=redis://redis:6379/0

ABC_AUTH_BOOTSTRAP_EMAIL=admin@example.edu.vn
ABC_AUTH_BOOTSTRAP_PHONE=0901234567
ABC_AUTH_BOOTSTRAP_PASSWORD=change-this-long-password
ABC_AUTH_BOOTSTRAP_DISPLAY_NAME=ABC SUN Admin
ABC_AUTH_ACCESS_TTL=15m
ABC_AUTH_REFRESH_TTL=168h
ABC_AUTH_COOKIE_SECURE=false

ABC_SUBSCRIPTION_AUTOMATION_ENABLED=false
ABC_SUBSCRIPTION_AUTOMATION_INTERVAL=5m

ABC_PAYOS_CLIENT_ID=
ABC_PAYOS_API_KEY=
ABC_PAYOS_CHECKSUM_KEY=
ABC_PAYOS_RETURN_URL=http://localhost:18181/payment-return
ABC_PAYOS_CANCEL_URL=http://localhost:18181/payment-cancel
ABC_PAYOS_API_BASE_URL=https://api-merchant.payos.vn
