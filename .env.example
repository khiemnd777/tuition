# Docker local environment for the Finance Hub stack.
# Copy to .env and replace placeholder values as needed.

DEKISUGI_ENV=local
COMPOSE_PROJECT_NAME=finance_hub

API_PORT=18180
ADMIN_PORT=18181
LANDING_PORT=18182
POSTGRES_PORT=15436
REDIS_PORT=16381
VITE_USE_POLLING=true
POSTGRES_DATA_DIR=./.docker/postgres_data
REDIS_DATA_DIR=./.docker/redis_data

POSTGRES_DB=dekisugi
POSTGRES_USER=dekisugi
POSTGRES_PASSWORD=dekisugi_local_password

DEKISUGI_DATABASE_URL_LOCAL=postgres://dekisugi:dekisugi_local_password@postgres:5432/dekisugi?sslmode=disable
REDIS_URL=redis://redis:6379/0

DEKISUGI_AUTH_BOOTSTRAP_EMAIL=admin@example.edu.vn
DEKISUGI_AUTH_BOOTSTRAP_PHONE=0901234567
DEKISUGI_AUTH_BOOTSTRAP_PASSWORD=change-this-long-password
DEKISUGI_AUTH_BOOTSTRAP_DISPLAY_NAME=DEKISUGI Admin
DEKISUGI_AUTH_ACCESS_TTL=15m
DEKISUGI_AUTH_REFRESH_TTL=168h
DEKISUGI_AUTH_COOKIE_SECURE=false

DEKISUGI_SUBSCRIPTION_AUTOMATION_ENABLED=false
DEKISUGI_SUBSCRIPTION_AUTOMATION_INTERVAL=5m

DEKISUGI_PAYOS_CLIENT_ID=
DEKISUGI_PAYOS_API_KEY=
DEKISUGI_PAYOS_CHECKSUM_KEY=
DEKISUGI_PAYOS_RETURN_URL=http://localhost:18181/payment-return
DEKISUGI_PAYOS_CANCEL_URL=http://localhost:18181/payment-cancel
DEKISUGI_PAYOS_API_BASE_URL=https://api-merchant.payos.vn
