# Copy to .env for local Docker overrides. Keep real production secrets out of git.

ABC_ENV=local

API_PORT=18180
ADMIN_PORT=18181
POSTGRES_PORT=15436
REDIS_PORT=16381
VITE_USE_POLLING=true

POSTGRES_DB=abcsun
POSTGRES_USER=abcsun
POSTGRES_PASSWORD=abcsun_local_password

ABC_DATABASE_URL_LOCAL=postgres://abcsun:abcsun_local_password@postgres:5432/abcsun?sslmode=disable
REDIS_URL=redis://redis:6379/0
